{
  "name": "opena2a",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source security platform for AI agents",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --concurrency=5",
    "lint": "turbo run lint",
    "lint:sast": "eslint 'packages/*/src/**/*.ts' 'packages/*/__tests__/**/*.ts'",
    "clean": "turbo run clean",
    "typecheck": "turbo run typecheck",
    "audit:consumer": "node scripts/audit-consumer-resolution.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.8.1",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@10.0.0",
  "overrides": {
    "adm-zip": "0.6.0"
  }
}
